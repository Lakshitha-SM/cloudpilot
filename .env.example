# CloudPilot AWS Real-Time Mode Configuration

# AWS Credentials (DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL)
AWS_ACCESS_KEY_ID=placeholder_key
AWS_SECRET_ACCESS_KEY=placeholder_secret
AWS_REGION=us-east-1

# Safety Controls
# READ_ONLY, DECISION_ONLY, or CONTROLLED_EXECUTION
CLOUDPILOT_AWS_MODE=READ_ONLY

# Tag filtering for CloudPilot managed EC2 instances
EC2_TAG_FILTER_KEY=CloudPilot-Managed
EC2_TAG_FILTER_VALUE=true

# Target ELB or application URL for the real HTTP workload generator
CLOUDPILOT_TARGET_URL=http://your-ec2-or-elb-endpoint.com
